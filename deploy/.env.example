# Values used by the local Compose and Caddy edge example. Copy this file to
# deploy/.env and never commit the filled copy.

# --- edge ---
SSP_DOMAIN=ssp.example.com
ACME_EMAIL=ops@example.com

# --- browser access ---
SSP_CORS_ORIGINS=https://wallet.example.com

# --- shared secrets ---
# Generate the admin token with: openssl rand -hex 32
SPARK_ADMIN_TOKEN=
# Leave LDK_MACAROON empty when the SSP reads LDK_MACAROON_FILE.
LDK_MACAROON=

# --- network and services ---
SSP_NETWORK=REGTEST
SO_HOSTS=spark-operator-0:8535,spark-operator-1:8535,spark-operator-2:8535
SO_IDENTITY_PUBKEYS=
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
LDK_GRPC_ADDR=ldk-server:3536
LDK_MACAROON_FILE=
LDK_TLS_CERT_FILE=

# --- source checkouts used by local image builds ---
SPARK_REF=/tmp/opencode/spark-ref
LDK_SERVER_REF=/tmp/opencode/ldk-server-ref
