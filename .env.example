# Every variable the SSP reads. Unset variables use the defaults below.
# Numeric variables are validated at startup: a malformed value stops the boot.

# --- listener, network, and edge ---
SSP_LISTEN_ADDR=127.0.0.1:5000
SSP_NETWORK=REGTEST
# Public URL the embedded wallet uses for its own GraphQL calls.
SSP_PUBLIC_URL=http://127.0.0.1:5000
# Comma-separated browser origins. Empty disables cross-origin access.
SSP_CORS_ORIGINS=

# --- embedded Spark wallet ---
# Leave SSP_IDENTITY_PUBKEY empty to publish the identity that the mnemonic
# derives. Set it as a deployment guard for a restored wallet.
SSP_DATA_DIR=./data
SPARK_MNEMONIC_FILE=./data/spark.mnemonic
# 1 refuses to create a mnemonic when the file is absent. Use 0 only for the
# first boot of an empty volume.
SPARK_MNEMONIC_REQUIRED=0
SSP_IDENTITY_PUBKEY=

# --- Spark Operators ---
# Ordered, comma-separated gRPC addresses and their identity keys. A bare host
# is used over https; an explicit scheme must be http(s), and http is only
# accepted on REGTEST or LOCAL.
SO_HOSTS=
SO_IDENTITY_PUBKEYS=
# Empty for the public trust store, or one certificate file per operator.
SO_CERT_FILES=
# Optional ordered SSP-private operator endpoints; enables just-in-time leaf
# splitting. Certificates follow the same rule as SO_CERT_FILES.
SSP_OPERATOR_HOSTS=
SSP_OPERATOR_CERT_FILES=
# FROST share threshold; must be between 1 and the operator count.
SSP_FROST_THRESHOLD=2
# Smallest child the local split policy creates. 0 disables split planning.
SSP_MIN_SPLIT_CHILD_SATS=330

# --- Lightning backend ---
# server (default) or embedded. Existing server deployments need no changes.
LDK_BACKEND=server
# Server mode only:
LDK_GRPC_ADDR=
LDK_API_KEY=
LDK_API_KEY_FILE=
LDK_TLS_CERT_FILE=
# Embedded mode only. Empty data dir selects <SSP_DATA_DIR>/ldk-node.
LDK_NODE_DATA_DIR=
# esplora (default) or bitcoind; must serve the selected SSP_NETWORK.
LDK_NODE_CHAIN_SOURCE=esplora
# Required only for the esplora chain source.
LDK_NODE_ESPLORA_URL=
# Required only for bitcoind. Host has no scheme, port, or wallet path.
LDK_NODE_BITCOIND_RPC_HOST=
LDK_NODE_BITCOIND_RPC_PORT=8332
LDK_NODE_BITCOIND_RPC_USER=
# A password file takes precedence; a missing or empty file fails startup.
LDK_NODE_BITCOIND_RPC_PASSWORD_FILE=
LDK_NODE_BITCOIND_RPC_PASSWORD=
# Optional first-start wallet rescan height; empty starts at the current tip.
LDK_NODE_BITCOIND_RESCAN_FROM_HEIGHT=
LDK_NODE_LISTEN_ADDR=0.0.0.0:9735
# Set true after first boot, so a missing seed prevents startup.
LDK_NODE_SEED_REQUIRED=false

# --- fees and caps ---
# Must be 0: fee-bearing Swap V3 fills are not supported.
SSP_SWAP_FEE_SATS=0
# Largest single swap; 0 removes the cap.
MAX_SWAP_TOTAL_SATS=1000000
# Both must be nonzero to enable instant deposit advances.
SSP_INSTANT_MAX_OUTSTANDING_SATS=0
SSP_INSTANT_MAX_DEPOSIT_SATS=0

# --- admin and status endpoints ---
# Generate with: openssl rand -hex 32. SIDECAR_TOKEN is read as a fallback.
SPARK_ADMIN_TOKEN=
# 1 serves these endpoints with no token. Production leaves this unset.
SPARK_ADMIN_ALLOW_NO_AUTH=
# 1 permits HTTP loopback webhook callbacks. REGTEST and LOCAL only.
SSP_WEBHOOK_ALLOW_LOCAL=

# --- cooperative withdrawals and static deposits ---
# Bitcoin Core wallet RPC; empty disables both. The path names a wallet, such
# as http://bitcoind:8332/wallet/ssp-withdrawals
COOP_BITCOIN_RPC_URL=
COOP_BITCOIN_RPC_USER=
# Preferred over COOP_BITCOIN_RPC_PASSWORD.
COOP_BITCOIN_RPC_PASSWORD_FILE=
COOP_BITCOIN_RPC_PASSWORD=
# Flat SSP fee in addition to the miner fee.
COOP_EXIT_FEE_SATS=0

# --- funding helper (e2e/fund-ssp.mjs) ---
SSP_BASE_URL=http://127.0.0.1:5000
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
# Comma-separated leaf denominations and how many of each to create.
FUND_LADDER=
FUND_MULTIPLICITY=3

RUST_LOG=info
